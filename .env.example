# Server Configuration
PORT=5000
NODE_ENV=development

# Security & Authentication
TOKEN_SECRET=devtrack-super-secure-production-jwt-secret-replace-me
TOKEN_EXPIRES_IN=7d

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/devtrack
# For MongoDB Atlas in production:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/devtrack?retryWrites=true&w=majority

# Client Origin (CORS)
CLIENT_URL=http://localhost:5173
